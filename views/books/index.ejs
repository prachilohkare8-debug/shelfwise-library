<%- include('../partials/header', { title, currentPath }) %>
<section class="page-intro"><div><p class="eyebrow"><span class="live-dot"></span> LIBRARY OPERATIONS <span class="eyebrow-divider">/</span> COLLECTION</p><h1>Your shelves,<br><em>at a glance.</em></h1><p class="intro-copy">A considered little space to keep the collection organised.</p></div><div class="date-card"><span class="date-label">TODAY AT THE DESK</span><strong id="today-date">28 October 2026</strong><span class="date-foot">Inventory workspace <i>↗</i></span></div></section>
<% if (notice) { %><div class="notice" role="status"><span>✓</span> <%= notice %><button type="button" class="notice-close" aria-label="Dismiss notification">×</button></div><% } %>
<section class="stats-grid" aria-label="Collection summary"><article class="stat-card stat-main"><span class="stat-label">TOTAL TITLES <span>↗</span></span><strong><%= allBooks.length.toString().padStart(2, '0') %></strong><small>Distinct records in collection</small><div class="stat-decoration">▤</div></article><article class="stat-card"><span class="stat-label">COPIES ON SHELF</span><strong><%= allBooks.reduce((sum, book) => sum + book.available, 0).toString().padStart(2, '0') %></strong><small>Available to borrow</small><div class="mini-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article><article class="stat-card"><span class="stat-label">NEEDS ATTENTION</span><strong><%= allBooks.filter(book => book.available === 0).length.toString().padStart(2, '0') %></strong><small>Titles currently checked out</small><div class="attention-mark">!</div></article></section>
<section class="collection-section"><div class="section-heading"><div><p class="eyebrow">THE CATALOGUE</p><h2>Book collection <span class="count-pill"><%= books.length %></span></h2></div><a class="text-link" href="/books/new">Add a new title <span>↗</span></a></div>
<form class="filter-bar" action="/books" method="get"><label class="search-box"><span aria-hidden="true">⌕</span><input name="q" type="search" value="<%= q %>" placeholder="Search title, author or ID…" aria-label="Search books"></label><label class="filter-select"><span>SHOWING</span><select name="category" aria-label="Filter by category"><% categories.forEach(item => { %><option value="<%= item %>" <%= category === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label><button class="filter-button" type="submit">Filter <span>→</span></button><% if (q || category !== 'All categories') { %><a class="clear-link" href="/books">Clear</a><% } %></form>
<div class="table-wrap"><table class="book-table"><thead><tr><th>BOOK / AUTHOR</th><th>BOOK ID</th><th>CATEGORY</th><th>AVAILABILITY</th><th>SHELF</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody><% if (books.length === 0) { %><tr><td colspan="6" class="empty-state"><span>⌕</span><strong>No books found</strong><small>Try another search or clear the filters.</small><a href="/books">View all titles</a></td></tr><% } %><% books.forEach((book, index) => { %><tr class="book-row"><td><a class="book-cell" href="/books/<%= book.id %>"><span class="book-cover cover-<%= index % 5 %>"><span><%= book.title.split(' ').slice(0,2).map(word=>word[0]).join('').toUpperCase() %></span></span><span class="book-text"><strong><%= book.title %></strong><small><%= book.author %></small></span></a></td><td><span class="book-id"><%= book.id %></span></td><td><span class="category-tag"><%= book.category %></span></td><td><span class="stock <%= book.available === 0 ? 'stock-out' : book.available <= 2 ? 'stock-low' : 'stock-good' %>"><i></i><%= book.available === 0 ? 'All borrowed' : `${book.available} of ${book.copies} available` %></span></td><td><span class="shelf-code"><%= book.shelf %></span></td><td><a class="row-action" href="/books/<%= book.id %>" aria-label="View <%= book.title %>">↗</a></td></tr><% }) %></tbody></table></div><div class="table-foot"><span>Showing <b><%= books.length %></b> of <b><%= allBooks.length %></b> titles</span><span class="foot-key"><i></i> Live inventory record</span></div></section>
<section class="bottom-note"><div class="note-icon">✳</div><div><strong>A good library is always in motion.</strong><p>Keep records up to date as new titles arrive and old favourites find their readers.</p></div><a href="/books/new" class="note-action">Add a title <span>↗</span></a></section>
<%- include('../partials/footer') %>
