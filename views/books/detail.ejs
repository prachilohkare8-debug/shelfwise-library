<%- include('../partials/header', { title, currentPath }) %><a class="back-link detail-back" href="/books">← Back to collection</a>
<section class="detail-layout"><div class="detail-cover cover-<%= Number(book.id.split('-')[1]) % 5 %>"><div class="cover-top">SHELFWISE <span>LIBRARY EDITION</span></div><div class="cover-monogram"><%= book.title.split(' ').slice(0,3).map(word=>word[0]).join('').toUpperCase() %></div><div class="cover-bottom"><span><%= book.category.toUpperCase() %></span><strong><%= book.title %></strong><small><%= book.author %></small></div></div><div class="detail-info"><p class="eyebrow">BOOK RECORD <span class="eyebrow-divider">/</span> <%= book.id %></p><h1><%= book.title %><em>.</em></h1><p class="detail-author">by <%= book.author %></p><span class="category-tag"><%= book.category %></span><div class="detail-rule"></div><div class="detail-facts"><div><small>BOOK ID</small><strong><%= book.id %></strong></div><div><small>ISBN</small><strong><%= book.isbn %></strong></div><div><small>SHELF LOCATION</small><strong><%= book.shelf %></strong></div><div><small>ADDED TO CATALOGUE</small><strong><%= book.addedAt %></strong></div></div><div class="availability-panel"><div><small>AVAILABILITY</small><strong><%= book.available %> <span>of <%= book.copies %> copies available</span></strong></div><span class="stock <%= book.available === 0 ? 'stock-out' : book.available <= 2 ? 'stock-low' : 'stock-good' %>"><i></i><%= book.available === 0 ? 'All borrowed' : book.available <= 2 ? 'Running low' : 'In stock' %></span></div><div class="detail-actions"><a class="button button-primary" href="/books/<%= book.id %>/edit">Edit record <span>↗</span></a><form action="/books/<%= book.id %>/delete" method="post" data-confirm="Remove this title from the inventory? This cannot be undone."><button class="button button-danger" type="submit">Remove title</button></form></div></div></section><%- include('../partials/footer') %>
