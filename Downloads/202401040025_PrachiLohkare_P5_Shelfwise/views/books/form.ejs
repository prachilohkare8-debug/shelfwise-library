<%- include('../partials/header', { title, currentPath }) %>
<div class="form-page-head"><a class="back-link" href="/books">← Back to collection</a><p class="eyebrow">COLLECTION MANAGEMENT <span class="eyebrow-divider">/</span> <%= isEdit ? 'EDIT RECORD' : 'NEW RECORD' %></p><h1><%= heading %><em>.</em></h1><p class="intro-copy">Good records make a better library. Fill in the details below.</p></div>
<% if (errors.length) { %><div class="form-errors" role="alert"><strong>Please check these details:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %>
<form class="book-form" action="<%= isEdit ? `/books/${book.id}/edit` : '/books' %>" method="post" novalidate><div class="form-card"><div class="form-card-head"><span class="step-no">01</span><div><h2>About this book</h2><p>The details readers will see in the catalogue.</p></div></div><div class="field-grid"><label class="field field-wide">Book title <span class="required">*</span><input name="title" required minlength="2" maxlength="100" value="<%= book.title || '' %>" placeholder="e.g. The Design of Everyday Things"><small>2–100 characters</small></label><label class="field">Author <span class="required">*</span><input name="author" required minlength="2" maxlength="80" value="<%= book.author || '' %>" placeholder="Author's full name"></label><label class="field">Category <span class="required">*</span><select name="category" required><% ['Fiction','Technology','Design','Personal Growth','Science','History','Other'].forEach(item => { %><option <%= book.category === item ? 'selected' : '' %> value="<%= item %>"><%= item %></option><% }) %></select></label><label class="field field-wide">ISBN <span class="required">*</span><input name="isbn" required pattern="[0-9Xx-]{10,17}" minlength="10" maxlength="17" value="<%= book.isbn || '' %>" placeholder="978-0-00-000000-0"><small>10–17 digits/characters; hyphens are allowed.</small></label></div></div>
<div class="form-card"><div class="form-card-head"><span class="step-no">02</span><div><h2>Stock & placement</h2><p>Help the next person find it on the shelf.</p></div></div><div class="field-grid"><label class="field">Total copies <span class="required">*</span><input name="copies" type="number" min="1" max="500" required value="<%= book.copies %>"><small>At least 1, up to 500</small></label><label class="field">Available copies <span class="required">*</span><input name="available" type="number" min="0" max="500" required value="<%= book.available %>"><small>Cannot exceed total copies</small></label><label class="field">Shelf code <span class="required">*</span><input name="shelf" required pattern="[A-Za-z]-[0-9]{2}" value="<%= book.shelf || '' %>" placeholder="T-04"><small>Use a letter and two digits, e.g. T-04</small></label></div></div>
<div class="form-actions"><span><span class="required">*</span> Required fields</span><a class="button button-quiet" href="/books">Cancel</a><button class="button button-primary" type="submit"><%= submitLabel %> <span>→</span></button></div></form>
<%- include('../partials/footer') %>
